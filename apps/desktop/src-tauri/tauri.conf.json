{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Routune",
  "version": "0.0.0",
  "identifier": "app.secondbrain.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "beforeBuildCommand": "pnpm --filter @secondbrain/client exec expo export --platform web"
  },
  "app": {
    "windows": [
      {
        "title": "Routune",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4RDIxRjdFOEI3RTkyRDYKUldUV2tuNkxmaC9TeUFJRDBZSkRFRjdUVG9CamhMYmdocDdZb2wwSDl4ZitOS3lMUE12d2kwemoK",
      "endpoints": ["https://github.com/omerdn/secondbrainv4/releases/latest/download/latest.json"]
    }
  }
}
