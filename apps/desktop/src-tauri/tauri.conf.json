{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Routune",
  "version": "0.0.0",
  "identifier": "app.secondbrain.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "beforeBuildCommand": "pnpm --filter @secondbrain/client exec expo export --platform web --dev"
  },
  "app": {
    "windows": [
      {
        "title": "Routune",
        "width": 1100,
        "height": 760,
        "url": "/dev/desktop"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
