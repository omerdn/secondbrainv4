{
  "name": "@secondbrain/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript types generated from the Rust API DTOs with ts-rs. Do not edit by hand.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@secondbrain/config": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
