{
  "name": "secondbrainv4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait postgres",
    "db:psql": "docker compose exec postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:check": "sh scripts/db-check.sh",
    "api-types:generate": "node scripts/generate-api-types.mjs"
  },
  "devDependencies": {
    "@secondbrain/config": "workspace:*",
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  }
}
