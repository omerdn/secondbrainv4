# Staging/beta reverse proxy (T0.7.1, ARCHITECTURE §17). Caddy obtains TLS certificates
# automatically for public domains; *.localhost names get certificates from Caddy's local CA.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Web client: static export of apps/client (single-page app).
{$WEB_DOMAIN} {
	import security_headers
	encode zstd gzip
	root * /srv/web
	# Hashed bundles never change; index.html always revalidates.
	@hashed path /_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# API and the /ws realtime channel (Caddy proxies WebSocket upgrades as-is).
{$API_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy server:8080 {
		# The server trusts proxy headers (TRUST_PROXY_HEADERS=true) for rate limiting. Caddy
		# replaces X-Forwarded-For for untrusted clients; also overwrite the other two so a
		# client cannot choose its own rate-limit key.
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
	}
}
