# Staging/beta settings (T0.7.1). Copy to infra/staging/.env (never committed) and fill in.
# The values below run the whole stack on this machine: https://app.localhost and
# https://api.localhost with certificates from Caddy's local CA.

# --- Domains (DNS A/AAAA records must point at the host; Caddy gets TLS automatically) ---
WEB_DOMAIN=app.localhost
API_DOMAIN=api.localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- Database. Use a long random, URL-safe password (e.g. `openssl rand -hex 32`). ---
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secondbrain

# --- Server (see the root .env.example for every option) ---
APP_ENV=staging
RUST_LOG=info,sqlx=warn
SENTRY_DSN=
EMAIL_DRIVER=log
# Desktop app origins (T0.6.4): tauri://localhost (macOS/Linux), http://tauri.localhost (Windows).
CORS_EXTRA_ORIGINS=tauri://localhost,http://tauri.localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_NATIVE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_SERVICES_ID=
APPLE_BUNDLE_IDS=

# Image tag of the built server/caddy images.
IMAGE_TAG=local
