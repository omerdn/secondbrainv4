# Static web client inside the `web` container (plain HTTP; TLS is terminated by the edge
# proxy, ADR-0021).
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip
	root * /srv/web
	# Hashed bundles never change; index.html always revalidates.
	@hashed path /_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	header -Server
	try_files {path} /index.html
	file_server
}
