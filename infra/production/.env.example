# Production settings (ADR-0021). On the host this file is /opt/routune/.env (never committed).
# For a local run of the whole stack see README.md ("Yerelde deneme").

# --- Domains: Cloudflare DNS A records -> host IP (DNS only) ---
WEB_DOMAIN=app.routune.dev
API_DOMAIN=api.routune.dev

# --- Database. Long random, URL-safe password: `openssl rand -hex 32`. ---
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secondbrain

# --- Server (see the root .env.example for every option) ---
# `staging` while EMAIL_DRIVER=log (refused in `production`). With Resend: production.
APP_ENV=staging
RUST_LOG=info,sqlx=warn
SENTRY_DSN=
# Resend (ADR-0022): EMAIL_DRIVER=resend, the API key and a sender on the verified domain.
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM=Routune <noreply@routune.dev>
# Desktop app origins (T0.6.4): tauri://localhost (macOS/Linux), http://tauri.localhost (Windows).
CORS_EXTRA_ORIGINS=tauri://localhost,http://tauri.localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_NATIVE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_SERVICES_ID=
APPLE_BUNDLE_IDS=
