# Copy to `.env` for local development: cp .env.example .env
# `.env` is git-ignored. Never put real secrets in this file.

# --- Local Postgres (compose.yaml) ---
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=secondbrain
POSTGRES_DB=secondbrain
POSTGRES_PORT=5432

# --- Server (server/crates/app) ---
# Defaults: 127.0.0.1:8080, 30 s drain on shutdown.
APP_HOST=127.0.0.1
APP_PORT=8080
SHUTDOWN_TIMEOUT_SECS=30

# --- Logging & error tracking (server/crates/app/src/telemetry.rs) ---
# json (default, production) or pretty (local development)
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn
# local | staging | production (reported to Sentry)
APP_ENV=local
# Optional. Empty = Sentry disabled.
SENTRY_DSN=

# --- E-mail (server/crates/kernel/src/email.rs) ---
# log = print e-mails (incl. links) to the log instead of sending; local development only,
# refused when APP_ENV=production. A real provider is added later (ARCHITECTURE §14).
EMAIL_DRIVER=log
# Public URL of the web app, used in e-mail links.
PUBLIC_WEB_URL=http://localhost:8081
# Public URL of this server (used for OAuth callbacks).
PUBLIC_API_URL=http://localhost:8080

# --- Google sign-in (T0.3.4). Empty = disabled (endpoints answer 404). ---
# Web client from the Google Cloud console; its authorized redirect URI must be
# $PUBLIC_API_URL/auth/google/callback. These are secrets: set them in .env, never commit.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated iOS/Android client ids accepted from the native apps.
GOOGLE_NATIVE_CLIENT_IDS=

# --- Database (server/crates/db) ---
# Required. Also used by sqlx-cli.
DATABASE_URL=postgres://secondbrain:secondbrain@localhost:5432/secondbrain
DB_MAX_CONNECTIONS=10
# Apply pending migrations at startup (default true).
DB_MIGRATE_ON_START=true
